{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "codex/*": false,
      "claude/*": false,
      "fda-feed-cache": false,
      "regulatory-document-cache": false,
      "clinical-data-cache": false,
      "product-data-cache": false,
      "evidence-data-cache": false
    }
  },
  "functions": {
    "api/source-test.js": {
      "maxDuration": 30,
      "includeFiles": "public/data/agencies.json"
    },
    "api/document-capture.js": {
      "maxDuration": 60,
      "includeFiles": "{public/data/agencies.json,public/regulatory-catalog*.js,scripts/document-{worker,masking-policy}.mjs,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**,node_modules/@napi-rs/canvas*/**}",
      "excludeFiles": "{node_modules/@napi-rs/canvas-linux-x64-musl/**,node_modules/pdfjs-dist/**/*.map}"
    },
    "api/document-collect.js": {
      "maxDuration": 60,
      "includeFiles": "{public/data/agencies.json,public/regulatory-catalog*.js,scripts/document-{worker,masking-policy}.mjs,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**,node_modules/@napi-rs/canvas*/**}",
      "excludeFiles": "{node_modules/@napi-rs/canvas-linux-x64-musl/**,node_modules/pdfjs-dist/**/*.map}"
    },
    "api/clinical-trials.js": {
      "maxDuration": 30,
      "includeFiles": "{companies/manifest.json,companies/registry.json}"
    },
    "api/refresh-worker.js": {
      "maxDuration": 30
    },
    "api/password-login.js": {
      "maxDuration": 60
    },
    "api/account-access.js": {
      "maxDuration": 60
    },
    "api/self-account.js": {
      "maxDuration": 60
    },
    "api/document-discovery.js": {
      "maxDuration": 30
    },
    "api/data-refresh.js": {
      "maxDuration": 60
    },
    "api/runtime-feed.js": {
      "maxDuration": 30,
      "includeFiles": "public/feed.xml"
    },
    "api/label-history.js": {
      "maxDuration": 30
    },
    "api/us-product-history.js": {
      "maxDuration": 30
    },
    "api/country-clinical.js": {
      "maxDuration": 30,
      "includeFiles": "public/data/agencies.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval' 'sha256-+ZFqKgkITCB7XdXnxM5FSGzQRX7MQ4tMbrggRrdQC8g=' 'sha256-Ac4Xxx6c8LvtsO8brin1gUkD6hFhW0p3FOMZ6kyHv5s=' 'sha256-ElShUWg/R0NC6WIMZp3N2FKE5siI90ZKCnHMHJYcUhk=' 'sha256-JDgiDrVHHANf47p8D3w84TSRSZareB8WNnZcS5pN0Ng=' 'sha256-WY8ZlPRpL9HZwrZnkH/kbKdaaBuPuzEyZmFCFgf9QvE=' 'sha256-iA4zTY6akqJiu47W0Q9TPTVfd6Xfnt5i2lJ6Dh81XfE='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https: wss://*.supabase.co; worker-src 'self' blob:; frame-src 'self' blob:; manifest-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    }
  ],
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pharmacovigilance-info.vercel.app"
        }
      ],
      "destination": "https://www.pvinfo.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/runtime-feed"
    }
  ]
}
