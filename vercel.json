{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/source-test.js": {
      "maxDuration": 30,
      "includeFiles": "public/data/agencies.json"
    },
    "api/document-capture.js": {
      "maxDuration": 60,
      "includeFiles": "{public/data/agencies.json,public/regulatory-catalog*.js,scripts/document-worker.mjs,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**,node_modules/@napi-rs/canvas*/**}"
    },
    "api/document-collect.js": {
      "maxDuration": 60,
      "includeFiles": "{public/data/agencies.json,public/regulatory-catalog*.js,scripts/document-worker.mjs,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**,node_modules/@napi-rs/canvas*/**}"
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    }
  ],
  "ignoreCommand": "node scripts/ignore-build.mjs"
}
