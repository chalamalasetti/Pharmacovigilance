{
  "name": "pvinfo",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacovigilance and drug regulatory updates from every major regulator, in one place.",
  "type": "module",
  "scripts": {
    "build": "npm run content:bundle && node scripts/build-user-guide.mjs && node scripts/clinical-import.mjs && node scripts/aggregate.mjs && node scripts/substances.mjs && node scripts/labels.mjs --bootstrap && node scripts/documents.mjs --bootstrap && node scripts/seo.mjs",
    "seo": "node scripts/seo.mjs --write",
    "aggregate": "node scripts/aggregate.mjs",
    "research": "node scripts/research.mjs",
    "registry": "node scripts/registry.mjs",
    "sources:sql": "node scripts/sources-sql.mjs",
    "resources:sql": "node scripts/resources-sql.mjs",
    "test": "node --test test/*.test.mjs",
    "app": "node scripts/app.mjs",
    "start": "node scripts/app.mjs",
    "documents": "node scripts/documents.mjs",
    "documents:probe": "node scripts/document-collector.mjs --probe",
    "dev": "node scripts/app.mjs --no-open --no-refresh",
    "clinical:backfill": "node scripts/clinical-bulk.mjs",
    "guide": "node scripts/build-user-guide.mjs",
    "substances": "node scripts/substances.mjs",
    "labels": "node scripts/labels.mjs",
    "content:bundle": "node scripts/build-content-export.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "buffer": "6.0.3",
    "docx": "9.5.1",
    "esbuild": "0.25.12",
    "fast-xml-parser": "5.11.2",
    "jose": "6.2.14",
    "linkedom": "0.18.14",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1"
  }
}
