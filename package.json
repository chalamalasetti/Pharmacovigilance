{
  "name": "pvinfo",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacovigilance and drug regulatory updates from every major regulator, in one place.",
  "type": "module",
  "scripts": {
    "build": "node scripts/aggregate.mjs && node scripts/seo.mjs",
    "seo": "node scripts/seo.mjs --write",
    "aggregate": "node scripts/aggregate.mjs",
    "research": "node scripts/research.mjs",
    "registry": "node scripts/registry.mjs",
    "sources:sql": "node scripts/sources-sql.mjs",
    "resources:sql": "node scripts/resources-sql.mjs",
    "test": "node --test test/*.test.mjs",
    "app": "node scripts/app.mjs",
    "start": "node scripts/app.mjs",
    "documents": "node scripts/documents.mjs",
    "documents:probe": "node scripts/document-collector.mjs --probe"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.0",
    "jose": "6.2.14",
    "linkedom": "0.18.14",
    "pdfjs-dist": "6.4.299"
  }
}
